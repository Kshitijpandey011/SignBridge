      },
      "te": {
        "text": "నాకు సహాయం కావాలి. నాకు నీరు కావాలి.",
        "needs_review": false
      },
      "bn": {
        "text": "আমার সাহায্য দরকার। আমার জল দরকার।",
        "needs_review": false
      },
      "mr": {
        "text": "मला मदत हवी आहे. मला पाणी हवे आहे.",
        "needs_review": false
